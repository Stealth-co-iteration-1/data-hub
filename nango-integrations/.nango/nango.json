        "auto_start": true,
        "endpoints": [
          {
            "method": "GET",
            "path": "/example/github/issues",
            "group": "Issues"
          }
        ],
        "input": "SyncMetadata_github_fetchissues",
        "name": "fetch-issues",
        "output": [
          "GithubIssue"
        ],
        "runs": "every hour",
        "scopes": [],
