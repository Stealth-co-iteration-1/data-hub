# Nango webhook signature verification
NANGO_WEBHOOK_SECRET="your-nango-webhook-secret"

# Database configuration
# Choose ONE of the following DATABASE_URL options:

# Option 1: SQLite (local development, default)
DATABASE_URL="sqlite:///./data-hub.db"

# Option 2: PostgreSQL (production or local testing with docker-compose)
# DATABASE_URL="postgresql://datahub:datahub@localhost:5432/datahub"

# For running PostgreSQL integration tests, set this env var:
# TEST_POSTGRES_URL="postgresql://datahub:datahub@localhost:5432/datahub"
